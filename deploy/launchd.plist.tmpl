<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template rendered by scripts/launchd.sh install. Edit this file, not the installed copy. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{REPO_DIR}}/scripts/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{REPO_DIR}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
  </dict>
  <!-- launchd never starts a new run while the previous one is still going. -->
  <key>StartInterval</key>
  <integer>{{INTERVAL}}</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{REPO_DIR}}/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO_DIR}}/logs/launchd.log</string>
</dict>
</plist>
