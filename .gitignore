# Paths starting with / match only at the repo root.

# Build output
/bin/
/main

# Secrets
/.env

# Per-user trading state: each clone starts its own wallet and history
/trader.db
/trader.db-*
/trader.db.import*
/NARRATIVE.md
/legacy/

# Pre-database state files (imported by `make init`)
/WALLET.json
/INITIAL_WALLET.json
/trades.jsonl
/journal.jsonl

# Runtime
/logs/
*.lock
.*.tmp

# OS
.DS_Store
